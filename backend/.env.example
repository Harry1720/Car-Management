# Backend Environment Variables
# Copy file này thành .env và điền các giá trị cần thiết

# ============== Server Configuration ==============
PORT=5000
NODE_ENV=development

# ============== Database Configuration ==============
# MongoDB URI - Nếu không có, server sẽ dùng localhost
# Ví dụ local: mongodb://localhost:27017/car-management
# Ví dụ MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/car-management
MONGODB_URI=mongodb://localhost:27017/car-management

# ============== JWT Configuration ==============
# JWT Secret Key - Dùng để ký token, tạo key bất kỳ (tối thiểu 32 ký tự)
# Ví dụ: your-super-secret-jwt-key-12345678901234567890
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# ============== Cloudinary Configuration ==============
# Lấy từ Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============== CORS Configuration ==============
# Địa chỉ frontend - Để frontend có thể gọi API
FRONTEND_URL=http://localhost:5173

EMAILJS_SERVICE_ID=id-cua-ban
EMAILJS_TEMPLATE_ID=id-cua-ban
EMAILJS_PUBLIC_KEY=key-cua-ban
EMAILJS_PRIVATE_KEY=key-cua-ban

# EMAIL_USER=dia_chi_gmail_cua_ban@gmail.com
# EMAIL_PASS=mat_khau_ung_dung_16_chu_cai

VNP_TMN_CODE=Mã_Website_Của_Bạn (Ví dụ: ZC3X...)
VNP_HASH_SECRET=Chuỗi_Bí_Mật_Của_Bạn (Ví dụ: ASDQWE...)
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=Link trả về sau khi thanh toán xong